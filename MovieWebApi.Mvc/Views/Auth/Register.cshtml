@model MovieWebApi.Mvc.Models.RegisterViewModel

<div class="container mt-4" style="max-width:400px;">
    <h2>Register</h2>

    <form asp-controller="Auth" asp-action="Register" method="post">
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" autocomplete="family-name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary">Register</button>
    </form>
</div>