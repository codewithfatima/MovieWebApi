@model List<MovieWebApi.Mvc.Models.GenreViewModel>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="d-flex justify-content-between w-50">
<form asp-action="Index" method="get">
        <input type="search" name="search" placeholder="Search with title" value="@Context.Request.Query["search"]" />
    <button class="btn btn-primary flex-fill" type="submit">Search</button>
    <a asp-action="Index" class="btn btn-outline-secondary" type="submit">Clear</a>
    </form>
</div>

  <div class="container mt-4">
      <div class="d-flex justify-content-lg-between align-items-center mb-3">
        <h2 class="mb-0 text-secondary">Genres</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add genre</a>
      </div>


      <div class="card shadow-sm">
             <table class="table table-hover mb-0 align-middle">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
        @foreach(var genre in Model)
        {
            <tr>
                <td>@genre.Id</td>
                <td>@genre.Name</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@genre.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            @if(ViewBag.IsAdmin){
                                <form asp-action="Delete" asp-route-id="@genre.Id" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are u sure u want to Delete this Genre')">Delete</button>
                                </form>
                            }
                 </td>
            </tr>
        }

        </tbody>
    </table>

      </div>

  </div>

